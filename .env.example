# ---------------------------------------------------------------- app
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=text                     # text | json
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_ON_STARTUP=true                # seed profile (+ sample jobs outside production) on first start

# ----------------------------------------------------------- database
# SQLite by default (file lives in ./data, relative paths resolve against the project root).
DATABASE_URL=sqlite:///./data/job_agent.db
#
# Hosted Postgres (Supabase / Neon) - needed for the GitHub Actions scheduler. Paste the
# *Session pooler* string from Supabase -> Connect (port 5432, IPv4-friendly); plain
# postgresql:// URLs are routed to the psycopg driver automatically.
# DATABASE_URL=postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ------------------------------------------------------------------ AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
# GEMINI_THINKING_BUDGET=0          # uncomment to disable "thinking" on 2.5 models (cheaper/faster)

OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_FALLBACK_MODEL=openrouter/free
OPENROUTER_JSON_MODE=false          # set true only if your model supports response_format=json_object

# Groq (free tier, very fast open models) - https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Model routing: comma separated provider chain, first one that works wins.
# Entries may be "provider" or "provider:model".
AI_ROUTE_CLASSIFICATION=groq,openrouter,gemini
AI_ROUTE_JOB_ANALYSIS=gemini,groq,openrouter
AI_ROUTE_RESUME_TAILORING=gemini,groq,openrouter
AI_ROUTE_APPLICATION_QUESTIONS=gemini,groq,openrouter
AI_ROUTE_FALLBACK=openrouter
AI_REQUEST_TIMEOUT=60
AI_MAX_RETRIES=3
AI_QUICK_FILTER_ENABLED=true        # cheap-model relevance check for ambiguous titles
AI_MAX_ANALYSES_PER_RUN=40          # cap on full analyses per search run (free-tier friendly)

# Prompt versions (bump to invalidate cached AI results for that task)
JOB_ANALYSIS_PROMPT_VERSION=1
RESUME_TAILORING_PROMPT_VERSION=1
APPLICATION_QUESTIONS_PROMPT_VERSION=1
JOB_FILTERING_PROMPT_VERSION=1

# ----------------------------------------------------------- discovery
JOB_SOURCES_ENABLED=remotive,arbeitnow,remoteok,jobicy,greenhouse,lever,ashby,adzuna
JOB_SOURCE_TIMEOUT=30
JOB_SOURCE_MAX_PER_SOURCE=200
# Adzuna (free developer key, covers India): https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

# ----------------------------------------------------------- scheduler
SCHEDULER_ENABLED=false             # runtime setting in the dashboard overrides this
SCHEDULE_CRON=0 8 * * *
SCHEDULE_TIMEZONE=Asia/Kolkata

# ------------------------------------------------------- notifications
NOTIFICATION_PROVIDERS=console      # console,email,telegram
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_USE_TLS=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------- browser
BROWSER_HEADLESS=false              # keep visible so you can review + submit manually
BROWSER_SLOW_MO_MS=0
BROWSER_TIMEOUT_MS=30000
BROWSER_KEEP_OPEN=true
